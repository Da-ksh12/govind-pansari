# ---------------------------------------------------------------------
# Mobile app (client-side, safe to ship — Expo only exposes vars
# prefixed EXPO_PUBLIC_ to the bundled app, and only the anon key
# belongs here).
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Crash/error reporting (services/monitoring/sentry.ts). A Sentry DSN is
# meant to be public — it only identifies which project to send events
# to, it grants no read/write access to your account. Leaving this blank
# just means crash reporting stays off (never a startup failure on its
# own, see that file's own guard).
EXPO_PUBLIC_SENTRY_DSN=
# Address picker provider. Leave blank (or "osm") for the OpenStreetMap map + OpenStreetMap/on-device
# search. Set to "google" ONLY in a build made together with a Google Maps SDK key for Android (see
# docs/google-address-setup.md): it switches BOTH the map and the address search to Google, because
# Google's terms require its place data to be shown on a Google map. A flag, not a secret.
EXPO_PUBLIC_ADDRESS_PROVIDER=

# ---------------------------------------------------------------------
# Local tooling only (Supabase CLI, seed scripts, migrations).
# NEVER prefix these with EXPO_PUBLIC_, never import them from app code,
# never commit the real values — this file is the template, not the
# secret.
# ---------------------------------------------------------------------

# `supabase link --project-ref <ref>` and `supabase db push` need this
# (Account -> Access Tokens in the Supabase dashboard).
SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection string, used for one-off psql/migration
# runs when not going through the CLI's linked-project flow.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Service role key — bypasses RLS entirely. Only ever used by
# supabase/seed/02_seed_demo_accounts.mjs and (in production) trusted
# server-side contexts like the payment-webhook Edge Function that
# calls confirm_payment(). Must never reach the mobile app bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Server-side secrets that do NOT belong in any .env file
# ---------------------------------------------------------------------
# These live only in Supabase (Dashboard -> Edge Functions -> Secrets, or
# `supabase secrets set NAME=...`), are read by Edge Functions, and must never
# be EXPO_PUBLIC_ variables or appear in the app. Names only — see
# docs/production-sms-and-payments.md for what each one is and how to set it:
#   SEND_SMS_HOOK_SECRETS  FAST2SMS_API_KEY  FAST2SMS_ROUTE  FAST2SMS_SENDER_ID
#   FAST2SMS_TEMPLATE_ID  FAST2SMS_TEMPLATE_VARIABLES  FAST2SMS_DLR_TOKEN
#   RAZORPAY_KEY_ID  RAZORPAY_KEY_SECRET  RAZORPAY_WEBHOOK_SECRET  RAZORPAY_ACCOUNT_ID
#   GOOGLE_MAPS_SERVER_API_KEY   (Places API (New) + Geocoding API; used only by the address-lookup function)
# Build-time only (environment variable or android/gradle.properties on the build machine, NOT in this file
# and NOT EXPO_PUBLIC_): GOOGLE_MAPS_ANDROID_API_KEY — the Maps SDK for Android key, restricted to the app.
