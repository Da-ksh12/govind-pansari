# ---------------------------------------------------------------------
# Mobile app (client-side, safe to ship — Expo only exposes vars
# prefixed EXPO_PUBLIC_ to the bundled app, and only the anon key
# belongs here).
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Crash/error reporting (services/monitoring/sentry.ts). A Sentry DSN is
# meant to be public — it only identifies which project to send events
# to, it grants no read/write access to your account. Leaving this blank
# just means crash reporting stays off (never a startup failure on its
# own, see that file's own guard).
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------
# Local tooling only (Supabase CLI, seed scripts, migrations).
# NEVER prefix these with EXPO_PUBLIC_, never import them from app code,
# never commit the real values — this file is the template, not the
# secret.
# ---------------------------------------------------------------------

# `supabase link --project-ref <ref>` and `supabase db push` need this
# (Account -> Access Tokens in the Supabase dashboard).
SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection string, used for one-off psql/migration
# runs when not going through the CLI's linked-project flow.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Service role key — bypasses RLS entirely. Only ever used by
# supabase/seed/02_seed_demo_accounts.mjs and (in production) trusted
# server-side contexts like the payment-webhook Edge Function that
# calls confirm_payment(). Must never reach the mobile app bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
