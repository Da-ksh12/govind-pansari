{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The Edge Function helpers in supabase/functions/_shared import each other with explicit
    // ".ts" extensions (required by Deno); type-checking only, nothing is emitted.
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/*/index.ts",
    // The online store is its own Next.js project with its own tsconfig; the app's type-check must not walk into it.
    "website"
  ]
}
