{
  "expo": {
    "name": "Govind Pansari",
    "slug": "govind-pansari",
    "scheme": "govindpansari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FBF3E6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.govindpansari.app"
    },
    "android": {
      "package": "com.govindpansari.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Govind Pansari uses your location to check delivery availability, estimate delivery time for your area, and — for delivery riders — share live location with the customer during an active delivery."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6E1423",
          "sounds": ["./assets/sounds/rider_delivery_alert.wav"],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Govind Pansari uses your photo library to let store admins upload product photos.",
          "cameraPermission": "Govind Pansari uses your camera so riders can capture a photo proof of delivery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ebb4e4e-49b8-4b27-9ecd-4686ad7e8041"
      }
    },
    "owner": "daksh_2502"
  }
}
