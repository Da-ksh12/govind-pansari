# Copy to .env.local and fill in. NEXT_PUBLIC_* values are visible in the browser, so they must be PUBLIC values only.
# Never put a Supabase service-role key, a Razorpay Key SECRET or a webhook secret in any file in this folder: those live in
# Supabase Edge Function secrets (see docs/production-sms-and-payments.md).

# The same Supabase project as the mobile app (Project settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of the website (used for links, sitemap and social previews). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact details the owner must supply. Anything left empty is simply not shown on the website
# (the mobile app's support number is a placeholder, so it is deliberately NOT reused here).
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
