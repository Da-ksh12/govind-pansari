# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# local npm cache/temp (redirected off the C: drive)
.cache/
.tmp/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env.example is the template and stays tracked
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
.npm-cache/

# EAS-downloaded signing credentials (contain keystore passwords)
/credentials.json
/credentials/

# Gradle build output of local native modules (modules/<name>/android) - generated by a release build, never committed
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# The online store (./website) is a separate Next.js project; its generated folders are never committed
/website/node_modules/
/website/.next/
/website/.screens/
# the zip prepared for uploading the website to the host
/deploy/
